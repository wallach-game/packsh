_packsh_bash_completion() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local prev="${COMP_WORDS[COMP_CWORD-1]}"

  case "$prev" in
    -l|--local)
      COMPREPLY=($(compgen -o dirnames -A directory -- "$cur"))
      return 0
      ;;
    -u|--uninstall)
      COMPREPLY=()
      return 0
      ;;
  esac

  if [[ "$cur" == -* ]]; then
    COMPREPLY=($(compgen -W '-l --local -u --uninstall --list -v --version -q --quiet --help' -- "$cur"))
  fi
}

complete -F _packsh_bash_completion packsh
